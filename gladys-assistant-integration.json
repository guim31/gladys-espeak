{
  "manifest_version": 1,
  "type": "tts",
  "name": "eSpeak NG",
  "description": {
    "en": "An offline voice for Gladys announcements: eSpeak NG runs on your machine, no Internet, no account.",
    "fr": "Une voix hors ligne pour les annonces de Gladys : eSpeak NG, sur votre machine, sans Internet.",
    "de": "Eine Offline-Stimme für Ansagen von Gladys: eSpeak NG läuft lokal, ohne Internet, ohne Konto.",
    "es": "Una voz sin conexión para los anuncios de Gladys: eSpeak NG en su máquina, sin Internet."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-espeak:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-espeak/main/cover.png",
  "categories": ["assistants"],
  "keywords": [
    "espeak",
    "espeak-ng",
    "tts",
    "text-to-speech",
    "synthèse vocale",
    "voix",
    "voice",
    "offline",
    "hors ligne"
  ],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "An offline voice, always available",
        "fr": "Une voix hors ligne, toujours disponible",
        "de": "Eine Offline-Stimme, immer verfügbar",
        "es": "Una voz sin conexión, siempre disponible"
      },
      "description": {
        "en": "eSpeak NG runs inside this integration: no Internet, no account, nothing leaves your network. The voice is robotic but clear, and keeps speaking when the Internet is down. Then select this voice on the Artificial Intelligence page.",
        "fr": "eSpeak NG tourne dans cette intégration : sans Internet ni compte, rien ne sort de votre réseau. La voix est robotique mais claire, et parle encore quand Internet est coupé. Choisissez ensuite cette voix sur la page Intelligence Artificielle.",
        "de": "eSpeak NG läuft in dieser Integration: ohne Internet und Konto, nichts verlässt dein Netzwerk. Die Stimme klingt robotisch, aber deutlich, und spricht auch ohne Internet. Wähle sie dann auf der Seite Künstliche Intelligenz.",
        "es": "eSpeak NG funciona dentro de esta integración: sin Internet ni cuenta, nada sale de su red. La voz es robótica pero clara, y sigue hablando sin Internet. Después, elija esta voz en la página Inteligencia artificial."
      },
      "links": [
        {
          "url": "https://github.com/espeak-ng/espeak-ng",
          "label": {
            "en": "eSpeak NG project",
            "fr": "Projet eSpeak NG",
            "de": "Projekt eSpeak NG",
            "es": "Proyecto eSpeak NG"
          }
        }
      ]
    },
    {
